#!/usr/bin/env ruby
# frozen_string_literal: true
#
# bin/new-app - scaffold a new app's legal/support docs from _templates/new-app/.
#
# Usage:
#   bin/new-app <app-slug> [--date YYYY-MM-DD] [--no-edit]
#
# Example:
#   bin/new-app my-app
#
# Creates _docs/<app-slug>/{index.md,privacy.md,terms.md,license.md} with the
# permalink, title and dates filled in. The display name is derived from the
# slug ("my-app" -> "My App"); the support address comes from `contact_email`
# in _config.yml. The only thing left to do afterwards is write the real legal
# text in privacy.md / terms.md / license.md.

require "date"
require "fileutils"
require "yaml"
require_relative "../_scripts/lib/front_matter"
require_relative "../_scripts/lib/reserved_slugs"

REPO_ROOT    = File.expand_path("..", __dir__)
TEMPLATE_DIR = File.join(REPO_ROOT, "_templates", "new-app")
DOCS_DIR     = File.join(REPO_ROOT, "_docs")

# Slugs that would publish to a URL clashing with a real top-level path -
# one list, shared with _scripts/validate_urls.rb.
RESERVED_SLUGS = ReservedSlugs::LIST

def die(msg)
  warn "error: #{msg}"
  exit 1
end

def usage
  warn <<~USAGE
    Usage: bin/new-app <app-slug> [--date YYYY-MM-DD] [--no-edit]

    Example:
      bin/new-app my-app
  USAGE
  exit 2
end

# --- parse args ----------------------------------------------------------------
args = ARGV.dup
usage if args.empty? || args.include?("-h") || args.include?("--help")

date_opt   = nil
no_edit    = false
positional = []
until args.empty?
  a = args.shift
  case a
  when "--date"          then date_opt = args.shift || die("--date needs a value")
  when /\A--date=(.+)\z/ then date_opt = Regexp.last_match(1)
  when "--no-edit"       then no_edit = true
  when /\A-/             then die("unknown option: #{a}")
  else positional << a
  end
end
die("expected 1 argument: <app-slug>") unless positional.size == 1
slug = positional.first

# --- validate ----------------------------------------------------------------
unless slug =~ /\A[a-z0-9]+(?:-[a-z0-9]+)*\z/
  die("invalid slug #{slug.inspect}: must be lowercase kebab-case " \
      "(a-z, 0-9, single hyphens, no leading/trailing/double hyphens)")
end
if RESERVED_SLUGS.include?(slug)
  die("slug #{slug.inspect} is reserved: it would collide with a top-level site " \
      "path (#{RESERVED_SLUGS.join(", ")})")
end
die("template dir not found: #{TEMPLATE_DIR}") unless Dir.exist?(TEMPLATE_DIR)

# Display name is derived from the slug, matching the site's Liquid helper
# (_includes/app-name.html): "my-app" -> "My App".
app_name = slug.split("-").map(&:capitalize).join(" ")

target = File.join(DOCS_DIR, slug)
die("#{File.join("_docs", slug)} already exists") if File.exist?(target)

# --- resolve date ------------------------------------------------------------
today = Date.today

def parse_iso(str)
  Date.iso8601(str)
rescue ArgumentError
  nil
end

doc_date =
  if date_opt
    d = parse_iso(date_opt) || die("--date must be a real YYYY-MM-DD date")
    die("--date #{date_opt} is in the future") if d > today
    d.iso8601
  elsif $stdin.tty?
    print "Effective date / last updated [YYYY-MM-DD] (default #{today}): "
    input = $stdin.gets.to_s.strip
    if input.empty?
      today.iso8601
    else
      d = parse_iso(input) || die("date must be a real YYYY-MM-DD date")
      die("date #{input} is in the future") if d > today
      d.iso8601
    end
  else
    today.iso8601
  end

# --- helpers ---------------------------------------------------------------
# YAML double-quoted scalar with backslash and quote escaped.
def yq(str)
  %("#{str.gsub(/[\\"]/) { |c| "\\#{c}" }}")
end

# Replace `key: <value>` lines, but only inside the leading front-matter block.
# FrontMatter.fill leaves body lines - including a `---` horizontal rule and any
# `key: value` beneath it - untouched.
def fill_front_matter(path, replacements)
  File.write(path, FrontMatter.fill(File.read(path), replacements))
end

# --- scaffold ---------------------------------------------------------------
FileUtils.mkdir_p(DOCS_DIR)
FileUtils.cp_r(TEMPLATE_DIR, target)

Dir.glob(File.join(target, "*.md")).sort.each do |f|
  if File.basename(f) == "index.md"
    fill_front_matter(f,
      "permalink" => "/#{slug}/",
      "title"     => yq(app_name))
  else
    fill_front_matter(f,
      "effective_date" => doc_date,
      "last_updated"   => doc_date)
  end
end

# --- self-check: permalink must match the folder ----------------------------
idx_fm = FrontMatter.parse_file(File.join(target, "index.md")) || {}
unless idx_fm["permalink"] == "/#{slug}/"
  die("internal: generated permalink #{idx_fm["permalink"].inspect} != /#{slug}/")
end

# --- summary ---------------------------------------------------------------
cfg  = (YAML.safe_load(File.read(File.join(REPO_ROOT, "_config.yml"))) rescue {}) || {}
base = "#{cfg["url"]}#{cfg["baseurl"]}"
puts "Created #{File.join("_docs", slug)}/"
Dir.glob(File.join(target, "*.md")).sort.each do |f|
  name = File.basename(f, ".md")
  url  = name == "index" ? "#{base}/#{slug}/" : "#{base}/#{slug}/#{name}/"
  puts format("  %-11s -> %s", File.basename(f), url)
end
puts "Name:   #{app_name} (derived from slug)"
puts "Dates:  effective_date = last_updated = #{doc_date}"
puts
puts "Next: replace the placeholder body text in the generated docs (privacy.md,"
puts "terms.md, license.md, ...) with the real text, then commit & push."
puts "CI (content lint) fails until you do."

# --- optional editor -----------------------------------------------------------
editor = ENV["EDITOR"] || ENV["VISUAL"]
if !no_edit && editor && $stdin.tty?
  docs = Dir.glob(File.join(target, "*.md")).reject { |f| File.basename(f) == "index.md" }.sort
  system(editor, *docs)
end
